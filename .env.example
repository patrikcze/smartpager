# Copy to .env and fill in. Never commit .env.
# Generate each secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Admin console / management API (list, read, ack, delete, devices). Local port only.
SMARTPAGER_ADMIN_TOKEN=
# Optional shared ingest token. Prefer named per-integration tokens:
#   make ingest-token NAME=grafana     (revocable one by one, shown in the audit log)
SMARTPAGER_INGEST_TOKEN=

# Address/port the server listens on (native `make run`) or is published on (Docker).
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable by the pager over the LAN (plain HTTP:
# trusted networks only; use an HTTPS reverse proxy otherwise).
SMARTPAGER_BIND=127.0.0.1
SMARTPAGER_PORT=8080

# Public HTTPS (docker compose --profile public / make up-public): Caddy + Let's Encrypt.
# When public, keep SMARTPAGER_BIND=127.0.0.1: the admin stays on this machine's local port.
SMARTPAGER_DOMAIN=
ACME_EMAIL=

# Native runs: path of the SQLite file (the container always uses /data/smartpager.db)
SMARTPAGER_DB=./data/smartpager.db
SMARTPAGER_RETENTION_DAYS=30
SMARTPAGER_TOMBSTONE_DAYS=7
SMARTPAGER_MAX_REQUEST_BYTES=65536
SMARTPAGER_RATE_LIMIT_PER_MIN=240
SMARTPAGER_MAX_LONG_POLL_S=25

# Backups (make backup / make backup-timer): how many archives to keep on the server, and an
# optional ingest token (make ingest-token NAME=backup) so a failed backup pages you.
BACKUP_KEEP=14
# BACKUP_NOTIFY_TOKEN=spi_...

# Optional IMAP connector (docker compose --profile email up -d)
# IMAP_INGEST_TOKEN=spi_...        # from: make ingest-token NAME=imap
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=me@example.com
# IMAP_PASSWORD=app-password-here
# IMAP_FOLDER=INBOX
# IMAP_POLL_SECONDS=60
# IMAP_ALLOW_SENDERS=@example.com,boss@
# IMAP_DENY_SENDERS=newsletter@,no-reply@
