# Copy to .env and fill in. Never commit .env.
# Generate each secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Admin console / management API (list, read, ack, delete, devices)
SMARTPAGER_ADMIN_TOKEN=
# Message ingestion only (scripts, webhooks, connectors). Must differ from the admin token.
SMARTPAGER_INGEST_TOKEN=

# Native runs: path of the SQLite file (the container always uses /data/smartpager.db)
SMARTPAGER_DB=./data/smartpager.db
SMARTPAGER_RETENTION_DAYS=30
SMARTPAGER_TOMBSTONE_DAYS=7
SMARTPAGER_MAX_REQUEST_BYTES=65536
SMARTPAGER_RATE_LIMIT_PER_MIN=240
SMARTPAGER_MAX_LONG_POLL_S=25

# Optional IMAP connector (docker compose --profile email up -d)
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=me@example.com
# IMAP_PASSWORD=app-password-here
# IMAP_FOLDER=INBOX
# IMAP_POLL_SECONDS=60
# IMAP_ALLOW_SENDERS=@example.com,boss@
# IMAP_DENY_SENDERS=newsletter@,no-reply@
